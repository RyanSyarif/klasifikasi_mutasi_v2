ENVIRONMENT=local
API_KEY=
PORT=8036
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=10485760
MAX_TRANSACTIONS=10000

# Runtime GPT OSS yang dipakai untuk menghasilkan data model V2.
LLM_BACKEND=bedrock
LLM_TEMPERATURE=0
LLM_TIMEOUT=300
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=2
LLM_BATCH_SIZE=20
LLM_MAX_TOKENS=8192
PROMPT_DIRECTORY=model_klasifikasi_v2/prompts

AWS_REGION=ap-southeast-3
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_CREDENTIAL_EXPIRATION=

# Federasi OIDC yang digunakan paket_penilai_llm untuk memperoleh credential AWS.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AWS_ROLE_ARN_BRIDGE=
AWS_ROLE_ARN_TARGET=

# Provider alternatif; tidak dipakai pada run GPT OSS Bedrock.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=

# Logistic Regression: batas bawah bin 3 dari prefix OOF tanpa false-positive.
CONFIDENCE_BINARY_THRESHOLD=0.9482552543312334
NAME_MATCHING_FUZZY_ENABLED=false
NAME_MATCHING_THRESHOLD=0.95
